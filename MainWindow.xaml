<Window x:Class="Esquillax.AudioSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Esquillax.AudioSwitcher.Models"
        mc:Ignorable="d"
        Title="AudioSwitcher"
        Icon="Resources/Icons/app.ico"
        Height="700" Width="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BgDark}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderNormal}"
            BorderThickness="1"
            Effect="{StaticResource ShadowEffect}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer/Status -->
            </Grid.RowDefinitions>

            <!-- ================= HEADER BAR ================= -->
            <Border Grid.Row="0"
                    Background="#111827"
                    CornerRadius="15,15,0,0"
                    BorderBrush="{StaticResource BorderNormal}"
                    BorderThickness="0,0,0,1"
                    MouseDown="Header_MouseDown"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/Icons/app.png"
                               Width="36" Height="36"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AudioSwitcher"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Fast Audio Device Toggle"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Toggle Button -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="Settings"
                                Margin="0,0,4,0">
                            <TextBlock Text="⚙" FontSize="16" />
                        </Button>

                        <!-- Refresh Devices -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Command="{Binding RefreshDevicesCommand}"
                                ToolTip="Refresh Audio Devices"
                                Margin="0,0,4,0">
                            <TextBlock Text="↻" FontSize="16" FontWeight="Bold" />
                        </Button>

                        <!-- Minimize -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="Minimize_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="─" FontSize="12" />
                        </Button>

                        <!-- Close -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="Close_Click"
                                ToolTip="Close (Minimizes to Tray)">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT ================= -->
            <Grid Grid.Row="1" Margin="18,16">
                <!-- NORMAL VIEW -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <!-- HERO TOGGLE CARD -->
                        <Border Background="{StaticResource BgCard}"
                                CornerRadius="14"
                                BorderBrush="{StaticResource BorderNormal}"
                                BorderThickness="1"
                                Padding="18"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CURRENT PLAYBACK DEVICE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CurrentDefaultDevice.DisplayName, FallbackValue='No Device Active'}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CurrentDefaultDevice.Name}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Visibility="{Binding CurrentDefaultDevice.HasAlias, Converter={StaticResource BoolToVis}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Active Badge -->
                                    <Border Grid.Column="1"
                                            Background="#1510B981"
                                            BorderBrush="{StaticResource StatusGreen}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource StatusGreen}" Margin="0,0,6,0" />
                                            <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreen}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- BIG SWITCH BUTTON -->
                                <Button Style="{StaticResource HeroActionButton}"
                                        Command="{Binding ToggleSwitchCommand}"
                                        IsEnabled="{Binding HasNextDevice}"
                                        Margin="0,4,0,8"
                                        Height="54">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SwitchButtonText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Click button or press global hotkey to cycle audio output instantly"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- CONFIGURED ROTATION SECTION -->
                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SELECT DEVICES FOR TOGGLE CYCLE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="Check devices below to include in the quick switch rotation:"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- DEVICE LIST -->
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AudioDeviceInfo}">
                                    <Border Margin="0,0,0,8"
                                            Background="{StaticResource BgCard}"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                                                        <Setter Property="Background" Value="#182338" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- Checkbox -->
                                                <ColumnDefinition Width="Auto" /> <!-- Icon -->
                                                <ColumnDefinition Width="*" />    <!-- Name & Details -->
                                                <ColumnDefinition Width="Auto" /> <!-- Actions -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox for Toggle Rotation -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelectedForToggle, Mode=TwoWay}"
                                                      Command="{Binding DataContext.ToggleDeviceInRotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Include in Toggle Rotation" />

                                            <!-- Device Icon -->
                                            <Border Grid.Column="1"
                                                    Width="36" Height="36"
                                                    CornerRadius="8"
                                                    Background="#2038BDF8"
                                                    Margin="4,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Device Names -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- Order badge if selected -->
                                                    <Border Margin="8,0,0,0"
                                                            Background="#2038BDF8"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSelectedForToggle, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding ToggleOrder, StringFormat='#{0}'}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentCyan}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Edit Alias Button -->
                                                <Button Style="{StaticResource WindowControlButton}"
                                                        Command="{Binding DataContext.StartEditingAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Rename / Set Nickname"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="✏" FontSize="13" />
                                                </Button>

                                                <!-- Make Default Button -->
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="10,6"
                                                        FontSize="11"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="Set Active" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SETTINGS PANEL OVERLAY ================= -->
                <Border Background="{StaticResource BgDark}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource BorderNormal}"
                        BorderThickness="1"
                        Padding="16"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Application Settings"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource WindowControlButton}"
                                        Command="{Binding ToggleSettingsCommand}">
                                    <TextBlock Text="✕" FontSize="13" />
                                </Button>
                            </Grid>

                            <!-- HOTKEY SETTINGS -->
                            <Border Background="{StaticResource BgCard}"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource BorderNormal}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GLOBAL SHORTCUT"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" />
                                    <CheckBox Content="Enable Global Keyboard Shortcut to Switch"
                                              IsChecked="{Binding Settings.EnableHotkey, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,10,0,8" />
                                    
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Current Shortcut:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <Border Background="#0F172A"
                                                    CornerRadius="6"
                                                    BorderBrush="{StaticResource BorderNormal}"
                                                    BorderThickness="1"
                                                    Padding="10,6"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Settings.HotkeyDisplayText}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyan}"
                                                           FontSize="13" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- BEHAVIOR & OSD -->
                            <Border Background="{StaticResource BgCard}"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource BorderNormal}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="BEHAVIOR &amp; NOTIFICATIONS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" />

                                    <CheckBox Content="Show On-Screen Floating Banner (OSD) on Switch"
                                              IsChecked="{Binding Settings.ShowOsd, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,12,0,8" />

                                    <CheckBox Content="Start AudioSwitcher with Windows (Minimized)"
                                              IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,4,0,8" />

                                    <CheckBox Content="Minimize window to System Tray"
                                              IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,4,0,8" />

                                    <CheckBox Content="Closing window minimizes to System Tray"
                                              IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,4,0,8" />

                                    <CheckBox Content="Switch Default Communications Device along with Multimedia"
                                              IsChecked="{Binding Settings.SwitchCommunicationsDevice, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,4,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- SAVE BUTTON -->
                            <Button Style="{StaticResource HeroActionButton}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Content="Save Settings"
                                    Height="44"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ================= ALIAS EDIT POPUP ================= -->
                <Border Background="#D0000000"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding IsEditingAlias, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="420">
                    <Border Background="{StaticResource BgCard}"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderAccent}"
                            BorderThickness="1.5"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Rename Device / Set Nickname"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Original Name:"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,8,0,2" />
                            <TextBlock Text="{Binding EditingDevice.Name}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="Custom Nickname (e.g. TV, Desktop Speakers):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,14,0,4" />
                            <TextBox Text="{Binding EditAliasText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BorderNormal}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontSize="13"
                                     CaretBrush="#FFFFFF"
                                     Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelEditingAliasCommand}"
                                        Content="Cancel"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource HeroActionButton}"
                                        Command="{Binding SaveAliasCommand}"
                                        Content="Save Nickname"
                                        Padding="16,8"
                                        FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- ================= FOOTER / STATUS BAR ================= -->
            <Border Grid.Row="2"
                    Background="#0B0F19"
                    CornerRadius="0,0,15,15"
                    BorderBrush="{StaticResource BorderNormal}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Left-click tray icon to switch anytime'}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="v1.0"
                               FontSize="10"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
